# ================================
# SOJIB AHMED PORTFOLIO — SERVER ENV
# ================================
# Copy this to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sojib-portfolio?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_very_secure_jwt_secret_key_here_2026
JWT_EXPIRES_IN=24h

# Admin Password (bcrypt hash of your admin password)
# Generate with: node -e "const b=require('bcryptjs'); console.log(b.hashSync('yourpassword',10))"
ADMIN_PASSWORD_HASH=$2a$10$...your.bcrypt.hash.here

# Email (Nodemailer - Gmail)
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_gmail_app_password
ADMIN_EMAIL=sojibahmedshorif998@gmail.com

# Gemini AI API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...your.gemini.api.key

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
